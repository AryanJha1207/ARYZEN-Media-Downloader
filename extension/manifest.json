{
  "manifest_version": 3,
  "name": "ARYZEN Media Downloader",
  "version": "2.0.0",
  "description": "Save video and audio from pages you browse, at the qualities the site actually offers. Runs fully on your own computer with a local yt-dlp engine.",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ARYZEN Media Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.reddit.com/*",
        "*://*.twitch.tv/*",
        "*://*.soundcloud.com/*",
        "*://*.streamable.com/*",
        "*://*.ted.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/ibm-plex-sans-italic-latin.woff2",
        "icons/tab-mark.png"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.reddit.com/*",
        "*://*.twitch.tv/*",
        "*://*.soundcloud.com/*",
        "*://*.streamable.com/*",
        "*://*.ted.com/*"
      ]
    }
  ]
}
